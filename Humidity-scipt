import pandas as pd
import matplotlib.pyplot as plt
from reportlab.platypus import SimpleDocTemplate, Image, PageBreak
from reportlab.lib.pagesizes import letter
import os

# =========================================================
# PATH SETUP (ROBUST)
# =========================================================
base_dir = os.path.dirname(os.path.abspath(__file__))

input_folder = os.path.join(base_dir, "Sofia")
output_folder = os.path.join(base_dir, "humidity")
temp_folder = os.path.join(output_folder, "temp_images")

# Create folders safely
os.makedirs(output_folder, exist_ok=True)
os.makedirs(temp_folder, exist_ok=True)

# File paths
csv_file = os.path.join(input_folder, "all_nodes_combined.csv")
main_pdf = os.path.join(output_folder, "humidity_overview.pdf")
district_pdf = os.path.join(output_folder, "humidity_by_district.pdf")

# =========================================================
# LOAD DATA
# =========================================================
df = pd.read_csv(csv_file)

df['timestamp'] = pd.to_datetime(df['timestamp'])
df['date'] = df['timestamp'].dt.date

# =========================================================
# DAILY GLOBAL AVERAGE
# =========================================================
daily_avg = df.groupby('date')['humidity'].mean().reset_index()

# =========================================================
# 1️⃣ MAIN PDF (ALL NEIGHBOURHOODS)
# =========================================================
main_img = os.path.join(temp_folder, "main_plot.png")

plt.figure(figsize=(12, 6))

for name, group in df.groupby('neighbourhood'):
    group = group.sort_values('timestamp')
    plt.plot(
        group['timestamp'],
        group['humidity'],
        linewidth=0.4  # very thin lines
    )

plt.plot(
    daily_avg['date'],
    daily_avg['humidity'],
    color='black',
    linewidth=3
)

plt.title("Humidity Across All Sofia Neighbourhoods")
plt.xlabel("Time")
plt.ylabel("Humidity")
plt.grid(True)

plt.tight_layout()
plt.savefig(main_img, dpi=300)
plt.close()

doc = SimpleDocTemplate(main_pdf, pagesize=letter)
doc.build([Image(main_img, width=500, height=300)])

# =========================================================
# 2️⃣ DISTRICT PDF (ONE PAGE PER NEIGHBOURHOOD)
# =========================================================
doc2 = SimpleDocTemplate(district_pdf, pagesize=letter)
elements2 = []

for name, group in df.groupby('neighbourhood'):
    group = group.sort_values('timestamp')

    # Daily average per neighbourhood
    daily_local = group.groupby('date')['humidity'].mean().reset_index()

    img_path = os.path.join(temp_folder, f"{name}.png")

    plt.figure(figsize=(10, 5))
    plt.plot(
        daily_local['date'],
        daily_local['humidity'],
        linewidth=1.5
    )

    plt.title(f"Annual Humidity Trend - {name}")
    plt.xlabel("Date")
    plt.ylabel("Humidity")
    plt.grid(True)

    plt.tight_layout()
    plt.savefig(img_path, dpi=300)
    plt.close()

    elements2.append(Image(img_path, width=500, height=300))
    elements2.append(PageBreak())

doc2.build(elements2)

# =========================================================
# CLEANUP TEMP FILES
# =========================================================
for file in os.listdir(temp_folder):
    os.remove(os.path.join(temp_folder, file))

os.rmdir(temp_folder)

# =========================================================
# DONE
# =========================================================
print("Done!")
print(f"Data read from: {csv_file}")
print(f"Outputs saved in: {output_folder}")